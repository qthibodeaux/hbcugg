 "definitions": {
  "lane": "left / middle / right, as the play-by-play records the run.",
  "lane_split": "loss_yards + line_yards_on_gains + highlight_yards_on_gains = the lane's yards. loss_yards: yards lost on carries that went backward (negative). On carries that gained: line_yards_on_gains = the line's credit (all of the first 4 yards, half of yards 5-10, none past 10); highlight_yards_on_gains = the rest of the gain.",
  "line_yards_per_carry": "The team's line yards per carry: the same credit on gains, and 120% of the yards lost on losses (the line is charged extra for a run blown up behind it).",
  "success_rate": "Share of carries that were successful on down and distance (50% of the yards to go on 1st down, 70% on 2nd, all of it on 3rd and 4th).",
  "opportunity_rate": "Share of carries that gained 4+ yards.",
  "highlight_yards_per_carry": "Yards beyond the line's credit, per carry.",
  "stuff_rate": "Share of carries stopped at or behind the line (0 or fewer yards).",
  "epa_per_carry": "Expected points added per carry.",
  "explosive_rate": "Share of carries that gained 12+ yards.",
  "top_rushers": "The team's five players with the most carries.",
  "ranks_18": "Rank among the 18 programs (Team Analytics).",
  "ranks_swac": "Rank among the 12 SWAC teams (1 = most; stuff rate: 1 = lowest). Ties share a rank.",
  "garbage_time": "Included in the lanes, the totals and the rushers.",
  "sacks": "Never rushes: sacks are not carries and are not in any rushing number."
 },
 "logging_notes": [
  "Lanes are charted on 99.7% of carries. uncharted_carries = carries with no lane in the play-by-play; the lanes' carries plus uncharted_carries = the team's carries.",
  "Uncharted carries in SWAC teams' games: Alcorn 1 (10 yards), ASU 1 (15), B-CU 1 (−1), Southern 1 (3); every other team 0. The lanes' yards plus those = the team's rushing yards."
